# ---------------------------------------------------------------------------
# IEEE IIIT Delhi website - environment template
#
# Copy to `.env` and fill in real values:   just setup
# `.env` is gitignored and must NEVER be committed.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# "development" relaxes CORS to the Vite dev server and enables /api/docs.
# Use "production" for any deployed environment.
ENVIRONMENT=development
# Public origin the site is served from. Used for canonical URLs, sitemap,
# Open Graph tags and absolute links in notification emails.
SITE_URL=http://localhost:5173

# --- Security --------------------------------------------------------------
# Signs admin session JWTs. Generate with: just secret
# Changing it invalidates every existing admin session.
SECRET_KEY=change-me-run-just-secret
# Admin access token lifetime, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Extra browser origins allowed to call the API, comma separated.
# The production SITE_URL is always allowed; leave empty unless you serve
# the frontend from a different host than the API.
CORS_ORIGINS=

# --- Database --------------------------------------------------------------
# Compose provides these for the bundled postgres service.
POSTGRES_USER=ieee
POSTGRES_PASSWORD=ieee-local-dev-password
POSTGRES_DB=ieee
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Overrides the POSTGRES_* pieces above when set. Required when Postgres is
# managed externally (see "Deployment" in README.md).
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# --- Administrator ---------------------------------------------------------
# There is exactly one admin account. It is created/updated by `just admin`,
# which reads these values. The password is argon2-hashed before storage and
# is never returned by the API.
ADMIN_EMAIL=ieee@iiitd.ac.in
ADMIN_PASSWORD=
# Login attempts allowed per IP inside the window below, then 429.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# --- Uploads ---------------------------------------------------------------
# Where admin-uploaded images are written. Mount this as a volume in prod so
# uploads survive container restarts.
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# --- Contact form notifications -------------------------------------------
# Submissions are always stored in Postgres and visible in the admin
# dashboard. Email is an optional extra notification channel.
#   console = log the message (default, good for local dev)
#   smtp    = send over SMTP using the settings below
#   none    = store only, never notify
EMAIL_BACKEND=console
EMAIL_FROM=ieee@iiitd.ac.in
# Where contact/collaboration notifications are delivered.
# Defaults to ADMIN_EMAIL when empty.
EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Frontend (build-time, Vite) ------------------------------------------
# Base URL the browser uses for API calls. Leave empty when the frontend is
# served by the same origin as the API (the default production setup).
VITE_API_BASE_URL=
